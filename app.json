{
  "expo": {
    "name": "OIS",
    "slug": "expo-app",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F5E9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "optivencustomerportal",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.optiven.optivencustomerportal",
      "buildNumber": "1.4.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.optiven.optivencustomerportal",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "5aae01d1-4f72-4b8f-b77a-81e94487d171"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
